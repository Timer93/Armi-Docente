{
  "name": "armi-docente-web",
  "private": true,
  "version": "11.4.16",
  "description": "ARMI Docente",
  "author": "ARMI",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev:backend": "node backend/server.js",
    "dev:frontend": "vite",
    "dev": "node scripts/dev.mjs",
    "dev:stop": "powershell -ExecutionPolicy Bypass -File scripts/dev-stop.ps1",
    "dev:clean": "powershell -ExecutionPolicy Bypass -Command \"npm run dev:stop; Start-Sleep -Seconds 2; npm run dev\"",
    "prepare:win-icon": "node scripts/prepare-windows-icon.mjs",
    "prepare:cloudflared": "node scripts/prepare-cloudflared.mjs",
    "rebuild:native:node": "node scripts/rebuild-better-sqlite3.mjs node",
    "rebuild:native:electron": "node scripts/rebuild-better-sqlite3.mjs electron",
    "prebuild": "node scripts/build-register-aggregation.mjs && node scripts/package-student-extension.mjs",
    "predev:backend": "node scripts/build-register-aggregation.mjs",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test:session-radial": "node --experimental-strip-types scripts/test-session-radial-layout.mjs && node scripts/test-session-radial-ui.mjs",
    "test:evidence-templates": "node scripts/test-evidence-templates.mjs && node scripts/test-evidence-template-pedagogy.mjs && node scripts/test-evidence-template-bots.mjs && node scripts/test-evidence-template-schedule.mjs && node scripts/test-evidence-template-routes.mjs && node scripts/test-evidence-template-ui.mjs",
    "test:import-session-activity": "node scripts/test-import-session-activity.mjs",
    "test:access-control": "node scripts/test-access-control.mjs",
    "test:access-control-ui": "node scripts/test-access-control-ui.mjs",
    "build:student-agent": "node scripts/build-student-agent.mjs",
    "test:student-agent": "node scripts/test-student-agent.mjs && node scripts/test-student-agent-autoconfig.mjs && node --experimental-strip-types scripts/test-student-agent-presence.mjs",
    "package:student-extension": "node scripts/package-student-extension.mjs",
    "test:student-extension": "node scripts/test-student-extension.mjs",
    "test:student-extension-browser": "node scripts/test-student-extension-browser.mjs",
    "test:student-extension-server": "node scripts/test-student-extension-server.mjs",
    "test:print-preview": "node --experimental-strip-types scripts/test-desktop-print-bridge.mjs && node scripts/test-print-preview.mjs",
    "test:session-word-merge": "node --experimental-strip-types scripts/test-session-word-merge.mjs",
    "preview": "vite preview",
    "electron": "electron .",
    "dist:win": "node scripts/build-installer.mjs",
    "release:github": "node scripts/publish-github-release.mjs",
    "push:github": "node scripts/push-github.mjs",
    "test:evidence-grade": "node scripts/test-evidence-grade-link.mjs",
    "test:evidence-startup": "node scripts/test-evidence-startup-reconciliation.mjs",
    "test:evidence-identity": "node scripts/test-evidence-student-identity.mjs",
    "test:background-sync": "node scripts/test-background-sync-indicator.mjs",
    "test:sync-transfer-ui": "node scripts/test-sync-transfer-controls.mjs",
    "test:sync-inventory": "node scripts/test-nonblocking-sync-inventory.mjs",
    "test:remote-retry-ui": "node scripts/test-remote-error-retry-ui.mjs",
    "test:sync-incremental": "node scripts/test-incremental-mirror-sync.mjs",
    "test:upload-resumable": "node scripts/test-resumable-upload.mjs",
    "test:upload-queue": "node scripts/test-upload-queue-recovery.mjs",
    "test:remote-presence": "node scripts/test-remote-presence.mjs",
    "test:quick-tunnel": "node scripts/test-quick-tunnel-verification.mjs",
    "test:student-chat-local": "node scripts/test-student-chat-local.mjs",
    "test:student-journal": "node scripts/test-student-journal.mjs",
    "test:student-navigation": "node scripts/test-student-portal-navigation.mjs",
    "test:teacher-messages": "node scripts/test-teacher-messages.mjs && node scripts/test-teacher-message-controller.mjs",
    "test:student-grades": "node scripts/build-register-aggregation.mjs && node scripts/test-student-gradebook.mjs",
    "test:session-plain-text": "node scripts/test-session-plain-text.mjs",
    "test:criterion-identity": "node scripts/build-register-aggregation.mjs && node scripts/test-register-criterion-identity.mjs",
    "test:unit56-adjustment": "node scripts/build-register-aggregation.mjs && node scripts/test-unit56-adjustment.mjs",
    "test:student-forum": "node scripts/test-student-forum.mjs",
    "test:student-forum-ui": "node scripts/test-student-forum-controller.mjs",
    "test:student-forum-privacy": "node scripts/test-student-forum-privacy.mjs",
    "test:evidence-folder-recovery": "node scripts/test-evidence-folder-recovery.mjs",
    "test:evidence-recovery-inventory": "node scripts/test-evidence-recovery-inventory.mjs",
    "test:fast-startup": "node scripts/test-fast-backend-startup.mjs",
    "test:startup-recovery": "node scripts/test-portable-bootstrap-recovery.mjs",
    "test:http-lan-uuid": "node scripts/test-http-lan-uuid.mjs",
    "test:desktop-close": "node scripts/test-desktop-close-handshake.mjs",
    "test:startup-navigation": "node scripts/test-startup-navigation.mjs",
    "test:startup-navigation-real": "node scripts/test-startup-navigation-real.mjs",
    "test:student-deliveries": "node scripts/test-student-portal-deliveries.mjs",
    "test:session-transversal": "node scripts/test-session-transversal-criteria.mjs",
    "test:session-resource-storage": "node scripts/test-session-resource-dual-storage.mjs",
    "test:session-resource-prompts": "node scripts/test-session-resource-prompts.mjs",
    "test:continuous-resource-mirror": "node scripts/test-continuous-resource-mirror.mjs",
    "test:mirror-json-reader": "node scripts/test-mirror-json-reader.mjs",
    "test:sync-performance": "node scripts/test-sync-status-performance.mjs",
    "test:sync-history-performance": "node scripts/test-sync-history-performance.mjs",
    "test:drive-detection-ui": "node scripts/test-drive-detection-ui.mjs",
    "test:session-distribution": "node scripts/test-ordered-session-distribution.mjs",
    "test:gemini-fallback": "node --experimental-strip-types scripts/test-gemini-model-fallback.mjs",
    "test:interactive-html": "node --experimental-strip-types scripts/test-interactive-html.mjs",
    "test:interactive-images": "node --experimental-strip-types scripts/test-interactive-image-library.mjs",
    "test:interactive-practice": "node scripts/test-interactive-practice-portal.mjs",
    "test:unit-session-export": "node scripts/test-unit-session-export-data.mjs",
    "test:unit-linked-evaluation": "node --experimental-strip-types scripts/test-unit-linked-evaluation.mjs",
    "test:unit-session-planning": "node scripts/test-unit-session-planning-sync.mjs",
    "test:resumable-upload": "node scripts/test-resumable-upload.mjs",
    "test:evidence-media": "node scripts/test-evidence-media.mjs",
    "migrate:u5-session-images": "node scripts/migrate-u5-session-resource-images.mjs --apply",
    "test:drive-launch": "node scripts/test-drive-desktop-launcher.mjs",
    "test:sync-queue": "node scripts/test-continuous-sync-queue.mjs",
    "test:installer-database": "node scripts/test-installer-database.mjs",
    "test:live-mirror": "node scripts/test-live-mirror-notifications.mjs",
    "test:installer-content": "node scripts/test-installer-content.mjs",
    "test:sync-concurrent": "node scripts/test-incremental-concurrent-writes.mjs",
    "test:sync-identities": "node scripts/test-sync-reference-identity.mjs",
    "test:grade-mirror": "node scripts/test-grade-mirror-identity.mjs",
    "test:slow-drive-startup": "node scripts/test-bootstrap-slow-drive.mjs",
    "test:identity-migration": "node scripts/test-prepared-identity-migration.mjs",
    "test:authority-refresh": "node scripts/test-authority-migration-refresh.mjs",
    "test:identity-reconciliation": "node scripts/test-mirror-reconciliation-plan.mjs",
    "test:data-epoch": "node scripts/test-data-epoch-fence.mjs",
    "test:sync-efficiency": "node scripts/test-sync-efficiency.mjs && node scripts/test-sync-delivery-status.mjs && node scripts/test-sync-publication-retry.mjs"
  },
  "dependencies": {
    "@google/genai": "^1.35.0",
    "@vitejs/plugin-react": "^5.1.2",
    "@vladmandic/human": "^3.3.6",
    "archiver": "^8.0.0",
    "better-sqlite3": "^12.5.0",
    "body-parser": "^2.2.1",
    "child_process": "^1.0.2",
    "cors": "^2.8.5",
    "docxtemplater": "^3.54.1",
    "docxtemplater-image-module": "^3.1.0",
    "docxtemplater-image-module-free": "^1.1.1",
    "electron-updater": "^6.6.2",
    "express": "^5.2.1",
    "ffmpeg-static": "^5.3.0",
    "fs": "^0.0.1-security",
    "lucide-react": "^1.17.0",
    "multer": "^2.2.0",
    "path": "^0.12.7",
    "pdfkit": "^0.20.1",
    "pizzip": "^3.1.7",
    "qrcode": "^1.5.4",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-quill-new": "^3.8.3",
    "recharts": "^3.6.0",
    "sharp": "^0.35.4",
    "url": "^0.11.4",
    "vite": "^7.3.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.1",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.27",
    "concurrently": "^9.2.1",
    "electron": "^37.2.3",
    "electron-builder": "^26.0.12",
    "linkedom": "^0.18.13",
    "png-to-ico": "^3.0.1",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.1",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  },
  "build": {
    "afterPack": "scripts/after-pack.cjs",
    "appId": "com.armi.docente",
    "productName": "ARMI Docente",
    "executableName": "ARMI Docente",
    "icon": "build/icon.ico",
    "artifactName": "ARMI_DOCENTE_Setup.${ext}",
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*",
      "node_modules/sharp/**/*",
      "node_modules/@img/**/*",
      "node_modules/ffmpeg-static/**/*"
    ],
    "buildDependenciesFromSource": false,
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "directories": {
      "output": "dist_electron"
    },
    "files": [
      "dist/**/*",
      "backend/**/*",
      "electron/**/*",
      "node_modules/**/*",
      "src/**/*",
      "sync-runtime/auth-settings.json",
      "package.json",
      "!backend/templates/**/*",
      "!backend/FolderPickerHelper/bin/**/*",
      "!backend/FolderPickerHelper/obj/**/*"
    ],
    "extraResources": [
      {
        "from": "backend/templates",
        "to": "backend/templates"
      },
      {
        "from": "build/installer-database",
        "to": "database",
        "filter": [
          "armi.db"
        ]
      },
      {
        "from": "electron/release-config.json",
        "to": "electron/release-config.json"
      },
      {
        "from": "build/icon.ico",
        "to": "app-icon.ico"
      },
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "electron/backend-process.cjs",
        "to": "backend-process.cjs"
      },
      {
        "from": "build/cloudflared/cloudflared.exe",
        "to": "cloudflared/cloudflared.exe"
      }
    ],
    "win": {
      "signAndEditExecutable": true,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "perMachine": true,
      "include": "build/installer.nsh",
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "ARMI Docente",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "runAfterFinish": true
    }
  }
}
