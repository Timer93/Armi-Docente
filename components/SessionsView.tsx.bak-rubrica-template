                                    <p className="font-black text-xs uppercase tracking-widest">No hay sesiones guardadas todavía.</p>
                                </div>
                            ) : (
                                <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
                                    {allSavedSessionsList.map((s, idx) => (
                                        <div 
