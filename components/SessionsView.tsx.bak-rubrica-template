                                            newInst[i][field] = val;
                                            handleInputChange('instrumento', newInst);
                                        };
                                        return (
                                            <tr key={row.id} className="divide-x divide-y divide-black/20 border-b border-slate-50 align-top group hover:bg-slate-50 transition-all">
