{
  "name": "armi-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-original-ui.mjs",
    "dev": "wrangler dev --local --port 8787 --var ARMI_ENV:local",
    "test": "node --test test/*.test.mjs",
    "db:local": "wrangler d1 migrations apply DB --local",
    "check:deploy": "wrangler deploy --dry-run --outdir .deploy-check",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@google/genai": "1.40.0",
    "@vladmandic/human": "3.3.6",
    "lucide-react": "1.17.0",
    "qrcode": "1.5.4",
    "quill": "2.0.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-quill-new": "3.8.3",
    "recharts": "3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "esbuild": "0.28.2",
    "postcss": "8.5.33",
    "tailwindcss": "4.2.1",
    "wrangler": "4.166.0"
  },
  "engines": {
    "node": ">=22.13"
  }
}
