{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "armi-docente-web",
  "account_id": "d925cb94b70eaf89d4ca106b5824d7bc",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-21",
  "workers_dev": true,
  "preview_urls": false,
  "build": { "command": "npm run build" },
  "routes": [
    { "pattern": "web.armiapp.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "ARMI_ENV": "staging",
    "ARMI_ADMIN_USERNAMES": "Timer",
    "ARMI_CF_ACCOUNT_ID": "d925cb94b70eaf89d4ca106b5824d7bc"
  },
  "analytics_engine_datasets": [
    { "binding": "USAGE_ANALYTICS", "dataset": "armi_web_usage" }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "armi-docente-web",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": { "crons": ["17 4 * * *"] }
}
